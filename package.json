{
  "name": "psyrec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local source-linked clinician documentation with QVAC VisionPsy",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:runtime": "npm run build && node dist/diagnostics/qvac-spike/probe.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "main": "dist/apps/desktop/main.js",
  "dependencies": {
    "@qvac/sdk": "0.18.2",
    "qrcode": "1.5.4",
    "selfsigned": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "40.10.6",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "electron@40.10.6": true
  }
}
