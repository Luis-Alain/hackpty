{
  "cli": {
    "version": ">=23.2.0",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "ios-internal": {
      "distribution": "internal",
      "node": "22.17.0",
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "credentialsSource": "remote",
        "image": "auto"
      }
    },
    "ios-simulator": {
      "extends": "ios-internal",
      "ios": {
        "simulator": true
      }
    }
  }
}
