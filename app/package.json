{
  "name": "vigia-server",
  "version": "0.1.0",
  "type": "module",
  "description": "Backend Hono + SQLite + RAG para Vigía (reto Philips)",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/db/schema.sql dist/db/",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "e2e": "bash test-e2e.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@qvac/sdk": "0.18.2",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  }
}
